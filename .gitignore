# env files (can opt-in for committing if needed)
.env*
!.env.production.example

# local app data / secrets
/storage/
/secrets/
*.db
*.sqlite
*.sqlite3

# local/generated project files
*.log
*.pdf
/tmp_*
/dev-server.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
