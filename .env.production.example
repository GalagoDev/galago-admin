APP_PASSWORD=change-me
STORAGE_DIR=./storage
DATABASE_PATH=./storage/data/store.db
# optional; otherwise a random signing secret is created in persistent storage
RECEIPT_LINK_SECRET=replace_with_at_least_32_random_characters
GOOGLE_SHEETS_ID=your_google_sheets_id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# safer Hostinger alternative if raw JSON gets mangled:
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=base64_encoded_service_account_json
# optional fallback if using a file instead:
# GOOGLE_SERVICE_ACCOUNT_PATH=./secrets/google-service-account.json
TELEGRAM_ORDERS_BOT_TOKEN=your_telegram_orders_bot_token
# optional but recommended, comma-separated if needed
TELEGRAM_ORDERS_ALLOWED_CHAT_ID=your_telegram_chat_id
# optional Telegram webhook secret-token header
TELEGRAM_ORDERS_WEBHOOK_SECRET=your_random_webhook_secret
OPENAI_API_KEY=your_openai_api_key
# optional, defaults to the cost-efficient vision model below
OPENAI_ORDER_MODEL=gpt-5.6-luna
