APP_PASSWORD=change-me
STORAGE_DIR=./storage
DATABASE_PATH=./storage/data/store.db
# optional; otherwise a random signing secret is created in persistent storage
RECEIPT_LINK_SECRET=replace_with_at_least_32_random_characters
GOOGLE_SHEETS_ID=your_google_sheets_id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# safer Hostinger alternative if raw JSON gets mangled:
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=base64_encoded_service_account_json
# optional fallback if using a file instead:
# GOOGLE_SERVICE_ACCOUNT_PATH=./secrets/google-service-account.json
TELEGRAM_ORDERS_BOT_TOKEN=your_telegram_orders_bot_token
# optional but recommended, comma-separated if needed
TELEGRAM_ORDERS_ALLOWED_CHAT_ID=your_telegram_chat_id
# optional Telegram webhook secret-token header
TELEGRAM_ORDERS_WEBHOOK_SECRET=your_random_webhook_secret
OPENAI_API_KEY=your_openai_api_key
# optional, defaults to the cost-efficient vision model below
OPENAI_ORDER_MODEL=gpt-5.6-luna
# Daily profitability / Meta Ads
STATISTICS_VAT_RATE=0.145
STATISTICS_SHIPPING_COST_BAM=8.5
STATISTICS_ACCESS_PASSWORD=Kesh
META_GRAPH_API_VERSION=v25.0
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=
META_ADS_TO_BAM_RATES_JSON={}

# Google Ads reporting (API v26; no developer token required since September 2026)
GOOGLE_ADS_CUSTOMER_ID=3221742913
# Existing GOOGLE_SERVICE_ACCOUNT_* credentials are reused by default.
# Enable Google Ads API / Explorer access in that Cloud project, then grant the
# service account Read-only access to the Ads customer above.
GOOGLE_ADS_SYNC_ENABLED=true
# Optional first full Europe/Sarajevo calendar date after fixing purchase value tracking.
# Earlier or mixed periods keep purchase counts but hide revenue/ROAS. YYYY-MM-DD.
# The cutoff excludes known bad history; it does not prove event values are correct.
# Leave blank only if existing history already contains actual order values.
GOOGLE_ADS_REVENUE_VALID_FROM=
# Optional dedicated service account JSON/base64; never use NEXT_PUBLIC_ secrets.
GOOGLE_ADS_SERVICE_ACCOUNT_JSON=
# Optional OAuth alternative (all three must be configured together).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Only for manager-account access; leave empty for direct customer access.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional external cron authentication. Internal hourly sync needs no cron.
GOOGLE_ADS_SYNC_SECRET=

# Ananas.ba product sync (prices are VAT-inclusive BAM; VAT is always 17%)
ANANAS_API_BASE_URL=https://api.ananas.rs
ANANAS_API_KEY=
ANANAS_CLIENT_ID=
ANANAS_CLIENT_SECRET=
ANANAS_VAT=17
ANANAS_DEFAULT_BRAND=Galago
ANANAS_DEFAULT_PACKAGE_WEIGHT_KG=1
# Keep 0 until Shopify inventory tracking or another real stock source is enabled.
ANANAS_UNTRACKED_STOCK_LEVEL=0
ANANAS_SYNC_SECRET=
ANANAS_INTERNAL_SCHEDULER_ENABLED=true

# Shopify custom app
SHOPIFY_STORE_DOMAIN=wktcnu-i5.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_API_VERSION=2026-07
# Local Lager quantities refresh from Galago Shopify every 10 minutes when configured.
SHOPIFY_INVENTORY_SYNC_ENABLED=true
# Optional legacy permanent token / webhook-secret overrides.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# Cron runner target; localhost is preferred when cron runs on the app server.
ANANAS_CRON_BASE_URL=http://127.0.0.1:3000
